APP_NAME="Qaireen Collection"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=web_ecomm
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment gateway (Midtrans Snap). Leave the keys empty to run in simulation
# mode: no request is sent to Midtrans, no Snap URL is produced, and the
# storefront offers the instant "simulate-pay" button instead.
# Sandbox keys: https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Shipping rates + tracking (RajaOngkir). Leave the API key empty to run the
# built-in tariff simulator; set RAJAONGKIR_SIMULATION=true to force it.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://pro.rajaongkir.com/api
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_COURIERS=jne,sicepat,jnt
RAJAONGKIR_WEBHOOK_TOKEN=
RAJAONGKIR_SIMULATION=false

# Company identity printed on invoices.
COMPANY_NAME="Qaireen Collection"
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_NPWP=

VITE_APP_NAME="${APP_NAME}"
